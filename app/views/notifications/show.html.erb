<%= content_for :title, @notification.title %>

<div class="w-full max-w-4xl mx-auto">
  <%# Back link %>
  <div class="mb-4">
    <%= link_to root_path, class: 'btn btn-ghost btn-sm' do %>
      <i class="bi bi-arrow-left"></i> Back
    <% end %>
  </div>

  <%# Header card %>
  <div class="card bg-base-200 mb-4">
    <div class="card-body gap-2 py-4">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h1 class="text-lg font-bold leading-snug">
            <% if @notification.link.present? %>
              <a href="<%= visit_notification_path(@notification) %>" target="_blank" rel="noopener noreferrer"
                 class="link link-primary">
                <%= @notification.title %>
                <i class="bi bi-box-arrow-up-right text-sm opacity-60"></i>
              </a>
            <% else %>
              <%= @notification.title %>
            <% end %>
          </h1>

          <div class="flex flex-wrap items-center gap-2 mt-2">
            <% if @notification.repo.present? %>
              <span class="badge badge-ghost badge-sm">
                <i class="bi bi-git mr-1"></i><%= @notification.repo %>
              </span>
            <% end %>
            <% if @notification.from_identifier.present? %>
              <span class="badge badge-ghost badge-sm">
                <i class="bi bi-robot mr-1"></i><%= @notification.from_identifier %>
              </span>
            <% end %>
            <% if @notification.mr_iid.present? %>
              <span class="badge badge-ghost badge-sm">
                <i class="bi bi-git mr-1"></i>!<%= @notification.mr_iid %>
              </span>
            <% end %>
            <% if @notification.reason_pipeline_failed? %>
              <span class="badge badge-error badge-sm">Pipeline failed</span>
            <% end %>
            <span class="text-xs text-base-content/40">
              <%= @notification.created_at.strftime('%b %-d, %Y at %H:%M') %>
            </span>
          </div>

          <% if @notification.summary.present? %>
            <p class="text-sm text-base-content/60 mt-2"><%= @notification.summary %></p>
          <% end %>
        </div>

        <div class="flex items-center gap-2">
          <% if @notification.available_mute_rule_types.any? %>
            <div class="dropdown dropdown-end">
              <div tabindex="0" role="button" class="btn btn-ghost btn-sm" title="Mute options"
                   aria-label="Mute options for <%= @notification.title %>">
                <i class="bi bi-bell-slash"></i>
              </div>
              <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-64 p-2 shadow-lg border border-base-300">
                <% @notification.available_mute_rule_types.each do |rule_type| %>
                  <li>
                    <%= button_to notification_mute_rule_path(@notification, rule_type: rule_type),
                          method: :post,
                          form: { data: { turbo: false }, class: 'w-full' },
                          class: 'flex w-full items-center gap-2 rounded-field px-3 py-2 text-left whitespace-nowrap hover:bg-base-200',
                          aria: { label: "Mute #{MuteRule::RULE_TYPES.fetch(rule_type)} for #{@notification.title}" } do %>
                      <i class="bi bi-bell-slash"></i>
                      Mute <%= MuteRule::RULE_TYPES.fetch(rule_type) %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# Done button %>
          <%= button_to done_notification_path(@notification), method: :patch,
                form: { data: { turbo: false } },
                class: 'btn btn-success btn-sm',
                title: 'Mark as done' do %>
            <i class="bi bi-check-lg"></i>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Email HTML body %>
  <div class="card bg-base-100 border border-base-300">
    <div class="card-body p-0 overflow-hidden rounded-box">
      <% if @html_body.present? %>
        <iframe srcdoc="<%= h(@html_body) %>"
                sandbox="allow-same-origin"
                class="w-full min-h-[600px] border-0"
                onload="this.style.height = this.contentDocument.body.scrollHeight + 'px'">
        </iframe>
      <% else %>
        <div class="flex flex-col items-center justify-center py-16 text-base-content/40">
          <i class="bi bi-envelope-x text-4xl mb-3"></i>
          <p>No email body available.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
